{
  "name": "@app/client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "compile:styles": "node scripts/compile-styles.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/compile-styles.mjs && rspack build -c rspack.client.config.mjs && rspack build -c rspack.server.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "zustand": "^5.0.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "devDependencies": {
    "@module-federation/enhanced": "^0.24.1",
    "@rspack/cli": "^2.0.2",
    "@rspack/core": "^2.0.2",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "sass-embedded": "^1.93.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
